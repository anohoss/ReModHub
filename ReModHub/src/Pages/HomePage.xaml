<Page x:Class="ReModHub.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:ReModHub.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ホーム">
    
    <Grid
        Margin="24"
        Background="{ui:ThemeResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <ui:TextBlock 
                Text="ReMod Hub へようこそ" 
                FontTypography="TitleLarge"
                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                HorizontalAlignment="Center"/>
            <ui:TextBlock 
                Text="サイドバーからライブラリにアクセスしてください" 
                FontTypography="Body"
                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"
                Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</Page>
