<ui:FluentWindow x:Class="ReModHub.Windows.EditGameProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ReModHub.Windows"
        mc:Ignorable="d"
        Title="プロファイル編集"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Auto"
        MinWidth="420"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.RowSpan="7"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True"/>

        <TextBlock Text="表示名"
                   FontWeight="SemiBold"/>
        <TextBox Grid.Row="1"
                 Margin="0,6,0,12"
                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2"
                   Text="バージョン"
                   FontWeight="SemiBold"/>
        <TextBox Grid.Row="3"
                 Margin="0,6,0,12"
                 Text="{Binding VersionName, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4"
                   Text="ベースゲーム"
                   FontWeight="SemiBold"/>
        <TextBlock Grid.Row="5"
                   Margin="0,6,0,12"
                   Text="{Binding BaseGameDisplay}"/>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="保存"
                    MinWidth="90"
                    IsDefault="True"
                    Click="OnSaveClicked"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
