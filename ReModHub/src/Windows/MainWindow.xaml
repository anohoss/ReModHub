<ui:FluentWindow x:Class="ReModHub.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ReModHub.Windows"
        xmlns:pages="clr-namespace:ReModHub.Pages"
        mc:Ignorable="d"
        Title="ReMod Hub" 
        MinHeight="750" MinWidth="1250"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Title="{Binding Title, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True" />

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsPaneOpen="True"
                           IsBackButtonVisible="Collapsed"
                           TitleBar="{Binding ElementName=AppTitleBar}">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem 
                    TargetPageType="{x:Type pages:HomePage}"
                    Content="ホーム"
                    Icon="{ui:SymbolIcon Home24}"/>
                <ui:NavigationViewItem 
                    TargetPageType="{x:Type pages:LibraryPage}"
                    Content="ライブラリ"
                    Icon="{ui:SymbolIcon Library24}"/>
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
