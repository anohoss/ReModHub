<ui:FluentWindow x:Class="ReModHub.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ReModHub.Windows"
        xmlns:pages="clr-namespace:ReModHub.Pages"
        xmlns:resources="clr-namespace:ReModHub.Resources"
        mc:Ignorable="d"
        Title="ReMod Hub" 
        MinHeight="750" MinWidth="1250"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Auto"
        WindowStartupLocation="CenterScreen"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True" />

        <Grid Grid.Row="1">
            <ui:NavigationView x:Name="RootNavigation"
                               PaneDisplayMode="Left"
                               IsPaneOpen="True"
                               IsBackButtonVisible="Collapsed">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem 
                        TargetPageType="{x:Type pages:HomePage}"
                        Content="ホーム"
                        Icon="{ui:SymbolIcon Home24}"/>
                    <ui:NavigationViewItem 
                        TargetPageType="{x:Type pages:LibraryPage}"
                        Content="ライブラリ"
                        Icon="{ui:SymbolIcon Library24}"/>
                    <ui:NavigationViewItem
                        TargetPageType="{x:Type pages:SettingsPage}"
                        Content="設定"
                        Icon="{ui:SymbolIcon Settings24}"/>
                </ui:NavigationView.MenuItems>
            </ui:NavigationView>
        </Grid>
    </Grid>
</ui:FluentWindow>
