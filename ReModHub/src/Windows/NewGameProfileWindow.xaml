<ui:FluentWindow x:Class="ReModHub.Windows.NewGameProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ReModHub.Windows"
        mc:Ignorable="d"
        Title="新規プロファイル"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Auto"
        MinWidth="440"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.RowSpan="7"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True"/>

        <TextBlock Text="表示名"
                   FontWeight="SemiBold"/>
        <TextBox Grid.Row="1"
                 Margin="0,6,0,12"
                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2"
                   Text="ベースゲーム"
                   FontWeight="SemiBold"/>
        <ComboBox Grid.Row="3"
                  Margin="0,6,0,12"
                  ItemsSource="{Binding BaseGameOptions}"
                  SelectedItem="{Binding SelectedBaseGameOption}"
                  DisplayMemberPath="DisplayText"/>

        <TextBlock Grid.Row="4"
                   Text="MOD (複数選択可)"
                   FontWeight="SemiBold"/>
        <Grid Grid.Row="5"
              Margin="0,6,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding ModOptions.Count, StringFormat=全MOD: {0}}"
                       Opacity="0.75"/>
            <TextBlock Grid.Column="2"
                       Text="{Binding SelectedMods.Count, StringFormat=選択済み: {0}}"
                       Opacity="0.75"/>

            <TextBlock Grid.Row="1"
                       Margin="0,6,0,0"
                       Text="検索 (名前 / バージョン / ID)"
                       Opacity="0.75"/>
            <TextBox Grid.Row="2"
                     Margin="0,0,0,6"
                     Text="{Binding ModSearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="2"
                       Grid.Row="1"
                       Margin="0,6,0,6"
                       VerticalAlignment="Center"
                       Text="選択済み"/>

            <ListBox Grid.Row="3"
                     Margin="0,0,6,0"
                     MinWidth="240"
                     Height="240"
                     ItemsSource="{Binding FilteredModOptions}"
                     SelectedItem="{Binding SelectedAvailableMod}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}"
                                   TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Column="1"
                        Grid.Row="3"
                        Margin="6,0"
                        VerticalAlignment="Center">
                <Button Content="追加 →"
                        MinWidth="90"
                        Margin="0,0,0,6"
                        Command="{Binding AddSelectedModCommand}"/>
                <Button Content="← 削除"
                        MinWidth="90"
                        Command="{Binding RemoveSelectedModCommand}"/>
            </StackPanel>

            <ListBox Grid.Column="2"
                     Grid.Row="3"
                     Margin="6,0,0,0"
                     MinWidth="240"
                     Height="240"
                     ItemsSource="{Binding SelectedMods}"
                     SelectedItem="{Binding SelectedSelectedMod}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayTextWithLock}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LockTooltip}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="作成"
                    MinWidth="90"
                    IsDefault="True"
                    Click="OnSaveClicked"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
